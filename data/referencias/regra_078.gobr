
# Regras para Comercial BH
version 1.0

time "empresa toda":
    vendedores todos

carteira "empresa comercial bh":
    clientes carteirafixa("empresa toda")

parametros "Regra Padrao da Empresa Customizavel: quinzenal para clientes ativos mas inadimplentes":
    da carteira("empresa comercial bh")
    quando ativos para o vendedor e inadimplentes
    frequencia de 14 dias
    preferencia nos dias uteis

parametros "Regra Padrao da Empresa Customizavel: semanal para clientes ativos e adimplentes":
    da carteira("empresa comercial bh")
    quando ativos para o vendedor
    frequencia de 7 dias
    preferencia nos dias uteis

parametros "Regra Padrao da Empresa Customizavel: mensal para clientes inativos e inadimplentes":
    da carteira("empresa comercial bh")
    quando inativos para o vendedor e inadimplentes
    frequencia de 30 dias
    preferencia nos dias uteis

parametros "Regra Padrao da Empresa Customizavel: quinzenal para clientes inativos e adimplentes":
    da carteira("empresa comercial bh")
    quando inativos para o vendedor
    frequencia de 14 dias
    preferencia nos dias uteis
    
parametros "Regra Padrao da Empresa Customizavel: quinzenal para clientes sem vendas":
    da carteira("empresa comercial bh")
    quando sem vendas
    frequencia de 14 dias
    preferencia nos dias uteis



