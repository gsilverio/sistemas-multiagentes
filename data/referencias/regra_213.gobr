    preferencia na sexta
    fixo
    
parametros "Clientes Inativos (sexta)":
    da carteira("carteira_sexta")
    frequencia de 28 dias
    preferencia na sexta
    fixo

parametros "Clientes sem dia específico":
    da carteira("carteira_curitiba")
    frequencia semanal()
    
