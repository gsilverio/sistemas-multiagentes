## Parâmetros para clientes somente do televendas

parametros "Prospects / Exclusivo do televendas":
    do time("tmk_1","tmk_2","tmk_3","tmk_5","tmk_6","tmk_7")
    quando no ciclo de vida prospect com a empresa
    frequencia de 7 dias

parametros "Ativos / Exclusivo do televendas":
    do time("tmk_1","tmk_2","tmk_3","tmk_5","tmk_6","tmk_7")
    quando recencia de positivacao global em 60 dias
    frequencia de 7 dias

parametros "Retenção / Exclusivo do televendas":
    do time("tmk_1","tmk_2","tmk_3","tmk_5","tmk_6","tmk_7")
    quando recencia de positivacao global em 90 dias
    frequencia de 7 dias

parametros "Recuperação / Exclusivo do televendas":
    do time("tmk_1","tmk_2","tmk_3","tmk_5","tmk_6","tmk_7")
    quando nao contido na segmentacao(
        "ext_niteroi_rio2_para_tmk1","ext_lagos_norte_para_tmk2","ext_baixada1_baixada3_para_tmk3",
        "ext_rio1_rio3_para_tmk5","ext_sulflu1_sulflu2_para_tmk6","ext_serrana_baixada2_para_tmk7"
    )
    frequencia de 7 dias


## Parâmetros para regra fallback

parametros "Clientes que hoje não se enquadraram nas regra solicitadas":
    do time("tmk_1","tmk_2","tmk_3","tmk_5","tmk_6","tmk_7")
    nao agendar
    
