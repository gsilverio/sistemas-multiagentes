#
## Definição de times

time "time televendas":
    vendedores todostelevendas

#
## Definição de carteiras

carteira "carteira televendas":
    clientes carteirafixa("time televendas")
    
#
## Parâmetros de planejamento

parametros "Não agendar clientes DH com crédito igual ou menor que R$0,00 (televendas)":
    da carteira("carteira televendas")
    quando nao tem credito e tipo de cobranca igual("DH")
    nao agendar

parametros "Não agendar clientes BK com crédito menor que R$200,00 (televendas)":
    da carteira("carteira televendas")
    quando com menos de R$ 80 de credito disponivel e tipo de cobranca igual("BK")
    nao agendar

parametros "Não agendar clientes inadimplentes (televendas)":
    da carteira("carteira televendas")
    quando inadimplentes
    nao agendar

parametros "Frequência de 7d para clientes ativos/adimplentes (televendas)":
    da carteira("carteira televendas")
    quando ativos para o vendedor
    frequencia de 7 dias

parametros "Frequência de 14d para clientes inativos/adimplentes (televendas)":
    da carteira("carteira televendas")
    quando inativos para o vendedor
    frequencia de 14 dias

parametros "Frequência de 14d para clientes sem venda (televendas)":
    da carteira("carteira televendas")
    quando sem venda
    frequencia de 14 dias
    
