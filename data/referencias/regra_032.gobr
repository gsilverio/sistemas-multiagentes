
#### Solicitação: https://gogeo.proofhub.com/bapplite/#app/todos/project-9580562790/list-270894162472/task-572233515403
version 1.0


### TIMES

time "televendas":
    vendedores todostelevendas ativados


### REGRAS PARA CARTEIRAS POR REGIÃO

carteira livre "sul_sudeste_centrooeste":
    clientes carteirafixa("televendas")
    quando uf do estado igual(
        "PR","SC","RS","SP","RJ","MG","ES","GO","MT","MS","DF"
    )

carteira livre "norte_nordeste":
    clientes carteirafixa("televendas")
    quando uf do estado igual(
        "AC","AP","AM","PA","RO","RR","TO","AL","BA","CE","MA","PB","PE","PI","RN","SE"
    )


### PARÂMETROS DE PLANEJAMENTO


## REGRAS GENÉRICAS

parametros "Baixados na Receita":
    do time("televendas")
    quando status na receita federal definido como baixada
    nao agendar

parametros "Prospects":
    da carteira("sul_sudeste_centrooeste","norte_nordeste")
    quando no ciclo de vida prospect com a empresa
    frequencia de 14 dias


