
# Card da aplicação: https://3.basecamp.com/3199393/buckets/26567206/card_tables/cards/6778635166
version 1.0

# Definição dos times:

time "televendas":
    vendedores todos ativados

# Parâmetros de não agendamento:

parametros "Girardi: Não agendar ramos de atividade diferente de 12, 13, 14, 15, 16, 17, 18 e 19":
    do time("televendas")
    quando ramo de atividade diferente("12","13","14","15","16","17","18","19")
    nao agendar

# Parâmetros de agendamento:

parametros "Girardi: 7d para ramo de atividade 12":
    do time("televendas")
    quando ramo de atividade igual("12")
    frequencia de 7 dias

parametros "Girardi: 14d para ramos de atividade 13, 14, 15, 16, 17, 18 e 19":
    do time("televendas")
    frequencia de 14 dias
    
