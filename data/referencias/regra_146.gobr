
# Solicitação: https://govendas-team.atlassian.net/browse/CS-29
version 1.0

## Regras para teste

time "televendas":
    vendedores todostelevendas ativados
    
parametros "Não Agendar Inadimplentes":
    do time("televendas")
    quando inadimplentes
    nao agendar

parametros "Segmento: Saude":
    do time("televendas")
    quando ramo de atividade igual("37","43","15")
    frequencia de 7 dias
    
parametros "Segmento: FOOD":
    do time("televendas")
    quando ramo de atividade igual("41","4","25")
        e frequencia historica de 7 dias
    frequencia de 7 dias
    
parametros "Cliente potencial":
    do time("televendas")
    quando sem venda do vendedor
    frequencia de 30 dias

parametros "Ativado: Fez um pedido e ainda não comprou mais":
    do time("televendas")
    quando unica compra com o vendedor
	    e recencia de positivacao em 30 dias
    frequencia de 30 dias

parametros "Ativo: compra regularmente":
    do time("televendas")
    quando frequencia historica menor que 21 dias
    frequencia de 21 dias

parametros "Em ruptura: risco de ficar inativo":
    do time("televendas")
    quando recencia de positivacao do vendedor entre 30 dias e 45 dias
    frequencia de 21 dias

parametros "Inativo: reativar cliente sem compra":
    do time("televendas")
    quando fora da recencia de positivacao do vendedor em 46 dias
    frequencia de 45 dias
    
