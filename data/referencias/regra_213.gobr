    frequencia de 28 dias
    preferencia na quarta
    fixo

parametros "Clientes Ativos (quinta)":
    da carteira("carteira_quinta")
    quando ativos para o vendedor
    frequencia semanal()
    preferencia na quinta
    fixo

parametros "Clientes Inativos (quinta)":
