

# Regras para Armazém Santa Maria
version 1.0

time "empresa toda":
    vendedores todos ativados

carteira "empresa toda":
    clientes carteirafixa("empresa toda")

parametros "Regra Padrao da Empresa Customizavel: semanal para clientes ativos e adimplentes":
    da carteira("empresa toda")
    quando ativos para o vendedor e adimplentes
    frequencia semanal()
    preferencia nos dias uteis e no sabado

parametros "Regra Padrao da Empresa Customizavel: 14 dias para clientes ativos e inadimplentes":
    da carteira("empresa toda")
    quando ativos para o vendedor e inadimplentes
    frequencia de 14 dias
    preferencia nos dias uteis e no sabado

parametros "Regra Padrao da Empresa Customizavel: 14 dias para clientes inativos e adimplentes":
    da carteira("empresa toda")
    quando inativos para o vendedor e adimplentes
    frequencia de 14 dias
    preferencia nos dias uteis e no sabado

parametros "Regra Padrao da Empresa Customizavel: nao agendar clientes inativos e inadimplentes":
    da carteira("empresa toda")
    quando inativos para o vendedor e inadimplentes
    nao agendar

parametros "Regra Padrao da Empresa Customizavel: 14 dias para clientes sem venda":
    da carteira("empresa toda")
    quando sem venda
    frequencia de 14 dias
    preferencia nos dias uteis e no sabado
    
    
