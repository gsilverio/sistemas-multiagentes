
version 1.0

time "time televendas":
    vendedores todostelevendas

time "time capital":
	vendedores todosdecampo menos("17","18","13")

time "time interior":
	vendedores porid("17","18","13")


## time televendas
parametros "Regra Padrao da Propec: Frequencia de 7 dias para clientes ativos (televendas)":
    do time("time televendas")
    quando ativos para o vendedor
    frequencia de 7 dias

parametros "Regra Padrao da Propec: Frequencia de 30 dias para clientes inativos (televendas)":
    do time("time televendas")
    quando inativos para o vendedor
    frequencia de 30 dias

parametros "Regra Padrao da Propec: Frequencia de 7 dias para clientes sem venda (televendas)":
    do time("time televendas")
    quando sem venda
    frequencia de 7 dias

