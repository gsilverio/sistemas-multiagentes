
### Solicitação: https://gogeo.proofhub.com/bapplite/#app/todos/project-9587835621/list-270919671655/task-543643460986
version 1.0


## Definição de times

time "televendas":
    vendedores todostelevendas ativados menos("39","11","63","8","49","31","29","10")

time "sao_paulo":
    vendedores porid("39","11","63","8","49","31","29","10")


## Parâmetros de agendamento time Televendas

parametros "Garantir recorrência de compra":
    do time("televendas")
    quando unica compra com a empresa
        e recencia de positivacao no mes
    frequencia de 5 dias

parametros "Alta frequência de compra":
    do time("televendas")
    quando recencia de positivacao entre 1 dias e 7 dias
    frequencia do historico ou no minimo de 1 dias e no maximo de 5 dias
    preferencia na segunda e na terca

parametros "Manter regularidade de compra":
    do time("televendas")
    quando recencia de positivacao entre 7 dias e 14 dias
    frequencia do historico ou no minimo de 7 dias e no maximo de 12 dias

parametros "Estimular compra dentro do mês":
    do time("televendas")
    quando recencia de positivacao entre 14 dias e 30 dias
    frequencia do historico ou no minimo de 14 dias e no maximo de 28 dias

parametros "Gerar relacionamento e estimular compra":
    do time("televendas")
    quando recencia de positivacao entre 31 dias e 90 dias
    frequencia de 14 dias

parametros "Resgate de clientes inativos":
    do time("televendas")
    quando recencia de positivacao entre 91 dias e 180 dias
    frequencia de 14 dias

parametros "Requalificar perfil e ativar cliente":
    do time("televendas")
    quando fora da recencia de positivacao em 360 dias
    frequencia de 21 dias


## Parâmetros de agendamento time São Paulo

parametros "Clientes com freq. semanal (Time São Paulo)":
    do time("sao_paulo")
    quando frequencia historica de 7 dias
    frequencia de 7 dias
    preferencia maior na segunda
    fixo

parametros "Clientes com freq. quinzenal (Time São Paulo)":
    do time("sao_paulo")
    quando frequencia historica de 14 dias
    frequencia de 14 dias
    preferencia maior na segunda
    fixo

parametros "Clientes com freq. mensal (Time São Paulo)":
    do time("sao_paulo")
    quando frequencia historica de 28 dias
    frequencia de 28 dias
    preferencia maior na segunda
    fixo

parametros "Clientes com freq. bimestral (Time São Paulo)":
    do time("sao_paulo")
    quando frequencia historica de 56 dias
    frequencia de 56 dias
    preferencia maior na segunda
    fixo

parametros "Clientes com freq. trimestral (Time São Paulo)":
    do time("sao_paulo")
    quando frequencia historica de 84 dias
    frequencia de 84 dias
    preferencia maior na segunda
    fixo

# Regra fallback
parametros "Clientes que não se enquadraram nas demais regras":
    do time("televendas", "sao_paulo")
    frequencia de 30 dias

