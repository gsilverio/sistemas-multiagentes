version 1.0

## Definição de times

time "televendas":
    vendedores todostelevendas ativados

## Regras de planejamento

parametros "Não agendar inadimplentes":
    do time("televendas")
    quando inadimplentes
    nao agendar

parametros "Não agendar bloqueados":
    do time("televendas")
    quando bloqueados
    nao agendar

parametros "Não agendar inativos":
    do time("televendas")
    quando inativos para a empresa
    nao agendar

parametros "Tem compra em até 20 dias atrás":
    do time("televendas")
    quando recencia de positivacao global em 20 dias
    nao agendar

parametros "Agendamento padrão - Rota":
    do time("televendas")
    quando data da rota hoje
    frequencia de 1 dia

parametros "Clientes prospects":
    do time("televendas")
    quando no ciclo de vida prospect com a empresa
    frequencia de 7 dias

parametros "Cliente ativado":
    do time("televendas")
    quando unica compra com a empresa
    frequencia de 15 dias

parametros "Compra regularmente":
    do time("televendas")
    quando recencia de positivacao global em 30 dias
        e frequencia historica menor que 30 dias
    frequencia do historico ou no minimo de 5 dias e no maximo de 30 dias

parametros "Em ruptura":
    do time("televendas")
    quando recencia de positivacao global entre 31 dias e 90 dias
    frequencia de 15 dias

parametros "Fora de rota":
    do time("televendas")
    nao agendar
    
