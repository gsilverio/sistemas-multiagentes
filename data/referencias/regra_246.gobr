
#### Solicitação: https://gogeo.proofhub.com/bapplite/#app/todos/project-9548242112/list-270761555428/task-558875550388
version 1.0


### TIMES

time "televendas":
    vendedores todostelevendas ativados


### REGRAS PARA CARTEIRAS POR RAMOS DE ATIVIDADE

carteira livre "ramos_1":
    clientes carteirafixa("televendas")
    quando ramo de atividade igual(
        "101009","101016","101025","101101","101102","101103","101104",
        "101105","201008","201009","201018","201099"
    )

