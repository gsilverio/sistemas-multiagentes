
version 1.0

time "time televendas":
    vendedores todostelevendas

time "time interior":
    vendedores porid("27", "35", "34")

time "time capital":
    vendedores todosdecampo menos ("27", "35", "34")
    
carteira "carteira televendas":
    clientes carteirafixa("time televendas")
    
carteira "carteira interior":
