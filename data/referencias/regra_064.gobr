
version 1.0

time "televenda":
    vendedores todostelevendas
    
time "campo":
    vendedores todosdecampo

carteira "carteira televendas":
    clientes carteirafixa("televenda")
    
carteira "carteira campo":
    clientes carteirafixa("campo")

###########################################
### Parametros televendas 

parametros "Regra Padrao da Royal Pet - Customizavel: Frequencia de 7 dias para ativos adimplentes (televendas)":
    da carteira("carteira televendas")
    quando ativos para o vendedor e adimplentes
    frequencia de 7 dias

