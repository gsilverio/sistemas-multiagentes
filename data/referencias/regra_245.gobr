### TIMES

time "televendas":
    vendedores todostelevendas ativados


### REGRAS PARA CARTEIRAS DE ROTAS POR CIDADE

carteira livre "rota_todo_dia":
    clientes carteirafixa("televendas")
    quando nome da cidade igual(
        "AMERICANA","ATIBAIA","BOM JESUS DOS PERDOES","CAMPINAS","HORTOLANDIA","INDAIATUBA","ITATIBA",
        "ITU","JARINU","JUNDIAI","LOUVEIRA","NOVA ODESSA","PAULINIA","SALTO","SUMARE","VALINHOS",
        "VINHEDO","PORANGABA","TAQUARITUBA"
    )

