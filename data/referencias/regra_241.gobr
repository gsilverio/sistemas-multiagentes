
### Solicitação: https://gogeo.proofhub.com/bappswift/#app/todos/project-9548242112/list-270761555428/task-516425000053
version 1.0


time "televendas":
    vendedores todostelevendas ativados


# BLOQUEIO INICIAL
############################################################

parametros "Não agendar clientes baixados na receita":
    do time("televendas")
    quando status na receita federal definido como baixada
    nao agendar

# PARAMETROS
###########################################################

parametros "Clientes revenda freq 7 dias":
    do time ("televendas")
    quando ramo de atividade igual("106","139","109","143","141","142")
    frequencia de 7 dias

parametros "Clientes revenda freq 14 dias":
    do time ("televendas")
    quando ramo de atividade igual("140","146","148")
    frequencia de 14 dias

parametros "Clientes revenda freq 28 dias":
    do time ("televendas")
    quando ramo de atividade igual("138")
    frequencia de 28 dias


parametros "Clientes comsumo freq 7 dias":
    do time ("televendas")
    quando ramo de atividade igual("144","147","108")
    frequencia de 7 dias

parametros "Clientes comsumo freq 14 dias":
    do time ("televendas")
    quando ramo de atividade igual("111","100","110","112","145","107","113")
    frequencia de 14 dias

parametros "Clientes comsumo freq 28 dias":
    do time ("televendas")
    quando ramo de atividade igual("114")
    frequencia de 28 dias

parametros "Clientes fora dos ramos mapeados":
    do time("televendas")
    nao agendar
    
