
# Solicitação: https://3.basecamp.com/3199393/buckets/26567206/card_tables/cards/7631515145#__recording_7654694057
version 1.0

## Definição de times

time "hunter_ativacao de novos":
    vendedores todostelevendas ativados menos("10185","1824")

time "farm_venda na base":
    vendedores porid("10185","1824")

## Regras de não agendamento (farm_venda na base)

parametros "Não agendar Prospects":
    do time("farm_venda na base")
    quando no ciclo de vida prospect com a empresa
    nao agendar

## Regras de não agendamento (todos)

parametros "Não agendar inadimplentes":
    do time("hunter_ativacao de novos","farm_venda na base")
    quando inadimplentes
    nao agendar

parametros "Não agendar bloqueados":
    do time("hunter_ativacao de novos","farm_venda na base")
    quando bloqueados
    nao agendar

## Regras de agendamento (hunter_ativacao de novos)

parametros "Freq. do histórico para 'Padrão de compra em até 30d'":
    do time("hunter_ativacao de novos")
    quando frequencia historica menor que 31 dias
    frequencia do historico
        ou no maximo de 30 dias

parametros "Freq. de 21d para 'Padrão de compra entre 30d e 90d'":
    do time("hunter_ativacao de novos")
    quando frequencia historica entre 31 dias e 90 dias
    frequencia de 21 dias

parametros "Freq. de 30d para 'Padrão de compra maior que 90d'":
    do time("hunter_ativacao de novos")
    frequencia de 30 dias

## Regras de agendamento (farm_venda na base)

parametros "Freq. de 30d para 'Estimular regularidade de compra'":
    do time("farm_venda na base")
    quando recencia de positivacao do vendedor entre 45 dias e 90 dias
    frequencia de 30 dias

parametros "Freq. de 25d para 'Risco de inatividade'":
    do time("farm_venda na base")
    quando recencia de positivacao do vendedor entre 91 dias e 180 dias
    frequencia de 25 dias

parametros "Freq. de 21d para 'Resgate de cliente sem compra - Inativos'":
    do time("farm_venda na base")
    quando inativos para o vendedor
    frequencia de 21 dias

parametros "Freq. do histórico para 'Alta frequência de compra'":
    do time("farm_venda na base")
    quando frequencia historica menor que 45 dias
    frequencia do historico ou no minimo de 40 dias e no maximo de 45 dias

