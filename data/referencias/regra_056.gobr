
version 1.0
# ADM Destra

time "prospec":
    vendedores porid("50", "53")

time "regra padrao":
    vendedores todos menos("50", "53")

carteira "regra padrao":
    clientes carteirafixa("regra padrao")
    
carteira "carteira prospec":
    clientes carteirafixa("prospec")
    
###
#  Regras RCA 50 e 53 (time de prospecção)   
#
parametros "Regra Padrao da Destra - Customizavel: 30 dias para clientes sem vendas (RCA 50 e 53)":
    da carteira("carteira prospec")
    quando sem vendas
    frequencia de 30 dias
    preferencia do vendedor

parametros "Regra Padrao da Destra - Customizavel: nao agendar clientes que ja compraram (RCA 50 e 53)":
    da carteira("carteira prospec")
    nao agendar

###
# Regras empresa toda menos RCA 50 e 53
#
parametros "Regra Padrao da Destra - Customizavel: 14 dias para Adimplentes ativos":
    da carteira("regra padrao")
    quando ativos para o vendedor e adimplentes
    frequencia de 14 dias
    preferencia do vendedor
    
parametros "Regra Padrao da Destra - Customizavel: 30 dias para Adimplentes inativos":
    da carteira("regra padrao")
    quando inativos para o vendedor e adimplentes
    frequencia de 30 dias
    preferencia do vendedor

parametros "Regra Padrao da Destra - Customizavel: 30 dias para ativos inadimplentes":
    da carteira("regra padrao")
    quando ativos para o vendedor e inadimplentes
    frequencia de 30 dias
    preferencia do vendedor

parametros "Regra Padrao da Destra - Customizavel: nao agendar inativos inadimplentes":
    da carteira("regra padrao")
    quando inativos para o vendedor e inadimplentes
    nao agendar

parametros "Regra Padrao da Destra - Customizavel: 30 dias para clientes sem vendas":
    da carteira("regra padrao")
    quando sem vendas
    frequencia de 30 dias
    preferencia do vendedor

