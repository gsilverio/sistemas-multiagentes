
version 1.0

time "ruptura global":
    vendedores porid("73","196","254","313")

time "time televendas":
    vendedores todostelevendas ativados menos("73","196","254","313")

time "campo":
    vendedores todosdecampo ativados

carteira "carteira televendas":
    clientes carteirafixa("time televendas")

carteira "carteira campo":
    clientes carteirafixa("campo")

### Regras time ruptura global 

parametros "Regra Padrao da Femac: 14 dias para clientes com mais de 31 dias sem compra com a empresa (ruptura global)":
    do time("ruptura global")
    quando inatividade global maior que 31 dias
    frequencia de 14 dias
    preferencia nos dias uteis
    
parametros "Regra Padrao da Femac: Não agendar cliente que compraram a menos de 31 dias (ruptura global)":
    do time("ruptura global")
    não agendar

