version 1.0

#
## Definição de Times

time "televendas":
    vendedores todostelevendas ativados

#
## Definição de carteiras por ramo de atividade

carteira livre "activity_in":
    clientes carteirafixa("televendas")
    quando ramo de atividade igual("1","2","3","4","8","18","23")

#
## Parâmetros de atendimento

parametros "Não agendar clientes filiais":
    da carteira("activity_in")
    quando e o cliente filial
    nao agendar

parametros "Não agendar clientes inadimplentes":
    da carteira("activity_in")
    quando inadimplentes
    nao agendar

parametros "Não agendar clientes com compra em 30d":
    da carteira("activity_in")
    quando recencia de positivacao em 30 dias
    nao agendar

parametros "Clientes ativos na empresa":
    da carteira("activity_in")
    quando ativos para a empresa
    frequencia de 14 dias

parametros "Clientes inativos na empresa":
    da carteira("activity_in")
    quando inativos para a empresa
    frequencia de 21 dias

parametros "Clientes que compraram em 2024 e estão sem vendas em 2025":
    da carteira("activity_in")
    quando tem venda da empresa no ano anterior
        e nao tem venda da empresa no ano
    frequencia de 21 dias

parametros "Clientes que compraram em 2023 e não compraram mais":
    da carteira("activity_in")
    quando recencia de positivacao entre '2023-12-31' e '2023-01-01'
    frequencia de 30 dias

parametros "Não agendar clientes fora das regras solicitadas":
    do time("televendas")
    nao agendar
    
