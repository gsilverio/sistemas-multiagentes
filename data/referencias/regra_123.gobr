
# Regras padrão
version 1.0

time "televendas":
    vendedores todostelevendas menos("7027")

time "time saude televendas":
 vendedores porid("7027")

time "campo":
    vendedores todosdecampo

## regras time interno
parametros "Regra Padrao do goVendas: Frequencia semanal para clientes ativos":
    do time("televendas")
    quando ativos para o vendedor
    frequencia de 7 dias

parametros "Regra Padrao do goVendas: Frequencia quinzenal para clientes inativos":
    do time("televendas")
    frequencia de 15 dias
    
## regras time saude interno
parametros "Regra Padrao do goVendas: Frequencia semanal para clientes ativos (saude)":
    do time("time saude televendas")
    quando ativos para o vendedor e ramo de atividade igual("1")
    frequencia de 7 dias

parametros "Regra Padrao do goVendas: Frequencia quinzenal para clientes inativos (saude)":
    do time("time saude televendas")
    quando  ramo de atividade igual("1")
    frequencia de 15 dias 
    
parametros "Regra Padrao do goVendas: Nao agendar ramo de atividade diferente de saude (saude)":
    do time("time saude televendas")
    nao agendar
    
## regras time externo

parametros "Regra Padrao do goVendas: Frequencia de 7 dias para clientes ativos (campo)":
    do time("campo")
    quando ativos para o vendedor
    frequencia de 7 dias
    fixo

parametros "Regra Padrao do goVendas: Frequencia de 14 dias para clientes inativos (campo)":
    do time("campo")
    frequencia de 15 dias
    fixo
    
