
version 1.0

time "televendas":
    vendedores todostelevendas
    
time "interior":
    vendedores porid("11", "3","12", "21")
    
time "capital":
    vendedores porid("2", "4", "5", "6")
    
carteira "capital":
    clientes carteirafixa("capital")
    
### Regras para televendas
parametros "Regra Padrao da NutriPet - Customizavel: 14 dias para clientes ativos (televendas)":
    do time("televendas")
    quando ativos para o vendedor
    frequencia de 14 dias
    preferencia nos dias uteis
    
parametros "Regra Padrao da NutriPet - Customizavel: 30 dias para clientes inativos (televendas)":
    do time("televendas")
    quando inativos para o vendedor
    frequencia de 30 dias
    preferencia nos dias uteis
    
parametros "Regra Padrao da NutriPet - Customizavel: 7 dias para clientes sem venda (televendas)":
    do time("televendas")
    quando sem venda
    frequencia de 7 dias
    preferencia nos dias uteis
    
## Regras Capital
parametros "Regra Padrao da NutriPet - Customizavel: 20 dias para clientes ativos adimplentes (capital)":
