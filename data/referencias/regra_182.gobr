
### Solicitação: https://govendas-team.atlassian.net/browse/CS-13?atlOrigin=eyJpIjoiZDYxY2M0ZTczNmY3NGM0OWI0NmI3ZGY5NDZmMjcxZjQiLCJwIjoiaiJ9
version 1.0

#
## Definição de Times

time "televendas":
    vendedores todostelevendas ativados

#
## Parâmetros de planejamento

parametros "Não agendar CPF":
    do time("televendas")
    quando pessoa fisica
    nao agendar

parametros "Não agendar inadimplentes":
    do time("televendas")
    quando inadimplentes
    nao agendar

parametros "Não agendar baixados na Receita":
    do time("televendas")
    quando status na receita federal definido como baixada
    nao agendar

parametros "Não agendar cliente com pedido nos últimos 7 dias":
    do time("televendas")
    quando recencia de positivacao em 7 dias
    nao agendar

parametros "Prospects dos ramos de atividade 89, 90, 91, 92, 93, 94, 95, 96, 97, 98, 99, 100, 101, 102, 103":
    do time("televendas")
    quando ramo de atividade igual("089","090","091","092","093","094","095","096","097","098","099","100","101","102","103")
        e no ciclo de vida prospect com a empresa
    frequencia de 7 dias

parametros "Ramo de atividade MANGUEIRAS com pedido em 45d":
    do time("televendas")
    quando ramo de atividade igual("089")
        e recencia de positivacao em 45 dias
    frequencia de 14 dias

parametros "Ramo de atividade MANGUEIRAS com pedido acima de 45d":
    do time("televendas")
    quando ramo de atividade igual("089")
    frequencia de 7 dias

parametros "Ramo de atividade MATERIAIS DE LIMPEZA com pedido em 60d":
    do time("televendas")
    quando ramo de atividade igual("090")
        e recencia de positivacao em 60 dias
    frequencia de 21 dias

