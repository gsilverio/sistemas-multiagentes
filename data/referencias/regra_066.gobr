
version 1.0

time "time campo":
    vendedores todosdecampo
    
time "time televendas":
    vendedores todostelevendas

carteira "carteira campo":
    clientes carteirafixa("time campo")
    
carteira "carteira televendas":
    clientes carteirafixa("time televendas")

#### Parametros televendas

parametros "Regra Padrao da Sul Frios - Customizavel: 7 dias para clientes ativos adimplentes (Internos)":
    da carteira ("carteira televendas")
    quando ativos para o vendedor e adimplentes
    frequencia de 7 dias
    preferencia nos dias uteis
    
parametros "Regra Padrao da Sul Frios - Customizavel: 14 dias para clientes ativos inadimplentes (Internos)":
    da carteira ("carteira televendas")
    quando ativos para o vendedor e inadimplentes
    frequencia de 14 dias
    preferencia nos dias uteis
    
parametros "Regra Padrao da Sul Frios - Customizavel: 30 dias para clientes inativos adimplentes (Internos)":
    da carteira ("carteira televendas")
    quando inativos para o vendedor e adimplentes
    frequencia de 30 dias
    preferencia nos dias uteis
    
parametros "Regra Padrao da Sul Frios - Customizavel: Nao agendar clientes inativos inadimplentes (Internos)":
    da carteira ("carteira televendas")
    quando inativos para o vendedor e inadimplentes
    nao agendar
    
parametros "Regra Padrao da Sul Frios - Customizavel: Nao agendar clientes sem vendas (Internos)":
    da carteira ("carteira televendas")
    quando sem venda
    nao agendar
    
