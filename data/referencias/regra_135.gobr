# -------------------------
# Definição de Times
# -------------------------

time "televendas_1":
    vendedores todostelevendas ativados menos("0000002")

time "televendas_2":
    vendedores porid("0000002")


# -------------------------
# Carteiras da Camila (Rotas)
# -------------------------

carteira livre "segunda_feira_televendas_2":
   clientes carteirafixa("televendas_2")
   quando nome da cidade igual("AGUAS DE SAO PEDRO","AMERICANA","ARARAS","CHARQUEADA","CORDEIROPOLIS","Cordeirópolis","IPEUNA","IRACEMAPOLIS","Iracemápolis","PIRACICABA","RIO CLARO","RIO DAS PEDRAS","SANTA BARBARA D OESTE","SANTA BÁRBARA D'OESTE","SANTA GERTRUDES","SAO PEDRO")

carteira livre "terca_feira_televendas_2":
   clientes carteirafixa("televendas_2")
   quando nome da cidade igual("AMERICO BRASILIENSE","ARARAQUARA","BARRINHA","CRAVINHOS","DESCALVADO","GUARIBA","IBATE","JABOTICABAL","LEME","MATAO","MONTE ALTO","PIRASSUNUNGA","PONTAL","PORTO FERREIRA","RIBEIRAO PRETO","SANTA CRUZ DAS PALMEIRAS","SANTA RITA DO PASSA QUATRO","SAO CARLOS","SERRANA","SERTAOZINHO","TAQUARITINGA")

carteira livre "quarta_feira_televendas_2":
   clientes carteirafixa("televendas_2")
   quando nome da cidade igual("AGUAI","AGUAS DE LINDOIA","AMPARO","ANDRADAS","ARTUR NOGUEIRA","ENGENHEIRO COELHO","ESPIRITO SANTO DO PINHAL","HOLAMBRA","ITAPIRA","JACUTINGA","JAGUARIUNA","LINDOIA","MOGI GUACU","MOGI MIRIM","MONTE ALEGRE DO SUL","MONTE SIAO","OURO FINO","PEDREIRA","PINHALZINHO","POCOS DE CALDAS","SAO JOAO DA BOA VISTA","SERRA NEGRA","SOCORRO")

carteira livre "quinta_feira_televendas_2":
   clientes carteirafixa("televendas_2")
   quando nome da cidade igual("ALUMINIO","ARACOIABA DA SERRA","BOITUVA","CERQUILHO","COTIA","IBIUNA","INDAIATUBA","IPERO","ITAPETININGA","ITAPEVI","ITU","MAIRINQUE","MONTE MOR","PORTO FELIZ","SALTO","SAO ROQUE","SOROCABA","TATUI","TIETE","VARGEM GRANDE PAULISTA","VOTORANTIM")

carteira livre "sexta_feira_televendas_2":
   clientes carteirafixa("televendas_2")
   quando nome da cidade igual("ATIBAIA","BRAGANCA PAULISTA","CAMPINAS","CAMPO LIMPO PAULISTA","COSMOPOLIS","HORTOLANDIA","ITATIBA","JUNDIAI","LOUVEIRA","NOVA ODESSA","PAULINIA","SUMARE","VALINHOS","VARZEA PAULISTA","VINHEDO")

carteira livre "irrestrito_televendas_2":
    clientes carteirafixa("televendas_2")
    quando nome da cidade igual("ARUJA","BARUERI","CAIEIRAS","CAJAMAR","CARAPICUIBA","DIADEMA","EMBU DAS ARTES","FERRAZ DE VASCONCELOS","FRANCISCO MORATO","FRANCO DA ROCHA","GUARULHOS","ITAQUAQUECETUBA","JANDIRA","MAIRIPORA","MAUA","MOGI DAS CRUZES","OSASCO","POA","RIBEIRAO PIRES","SANTANA DE PARNAIBA","SANTO ANDRE","SAO BERNARDO DO CAMPO","SAO CAETANO DO SUL","SAO PAULO","SUZANO")


# -------------------------
# Parametrização (Perfil + Rota)
# -------------------------

parametros "Prospects Segunda":
    da carteira("segunda_feira_televendas_2")
    quando no ciclo de vida prospect com o vendedor
    frequencia semanal()
    preferencia na sexta

parametros "Alta Frequencia Segunda":
    da carteira("segunda_feira_televendas_2")
    quando recencia de positivacao do vendedor em 30 dias
    frequencia semanal()
    preferencia na sexta

parametros "Regularidade Segunda":
    da carteira("segunda_feira_televendas_2")
    quando recencia de positivacao do vendedor em 45 dias
    frequencia semanal()
    preferencia na sexta

parametros "Risco Inatividade Segunda":
    da carteira("segunda_feira_televendas_2")
    quando fora da recencia de positivacao global em 120 dias
    frequencia semanal()
    preferencia na sexta

parametros "Inativos Segunda":
    da carteira("segunda_feira_televendas_2")
    quando fora da recencia de positivacao em 180 dias
    frequencia semanal()
    preferencia na sexta

parametros "Sem Regra Segunda":
    da carteira("segunda_feira_televendas_2")
    frequencia semanal()
    preferencia na sexta
    
    
