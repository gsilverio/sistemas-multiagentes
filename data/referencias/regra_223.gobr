#
## Definição de regras

parametros "Cliente com pedido nos últimos 30 dias":
    do time("ativacao")
    quando recencia de positivacao em 30 dias
    frequencia de 21 dias

parametros "Cliente sem pedido nos últimos 30 dias":
    do time("ativacao")
    frequencia de 15 dias

parametros "Cliente com compra na semana corrente (Entre seg. e sex)":
    do time("generalista")
    quando recencia de positivacao na semana
    nao agendar

parametros "Cliente semanal - padrão":
    do time("generalista")
    frequencia de 7 dias

parametros "Todos os clientes":
    do time("construtora")
    frequencia de 14 dias

