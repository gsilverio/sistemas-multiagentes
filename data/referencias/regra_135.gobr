## Irrestrito

parametros "Irrestrito: Clientes prospects":
    da carteira("irrestrito_televendas_2")
    quando no ciclo de vida prospect com o vendedor 
    frequencia semanal()

parametros "Irrestrito: Clientes com Alta Freq. de compra":
    da carteira("irrestrito_televendas_2")
    quando recencia de positivacao em 7 dias
    frequencia de 7 dias

parametros "Irrestrito: Clientes que compram com regularidade":
    da carteira("irrestrito_televendas_2")
    quando recencia de positivacao em 45 dias
    frequencia de 14 dias

parametros "Irrestrito: Risco de ficar inativo curva A":
    da carteira("irrestrito_televendas_2")
    quando fora da recencia de positivacao global em 120 dias
           e curva a com a empresa
    frequencia de 14 dias

parametros "Irrestrito: Risco de ficar inativo curva B":
    da carteira("irrestrito_televendas_2")
    quando fora da recencia de positivacao global em 120 dias
           e curva b com a empresa
    frequencia de 30 dias

parametros "Irrestrito: Risco de ficar inativo curva C":
    da carteira("irrestrito_televendas_2")
    quando fora da recencia de positivacao global em 120 dias
           e curva c com a empresa
    frequencia de 30 dias

parametros "Irrestrito: Clientes inativos":
    da carteira("irrestrito_televendas_2")
    quando fora da recencia de positivacao em 180 dias
    frequencia de 21 dias
    
parametros "cidade SÃO JOSE DO RIO PRETO - 30 dias":
    do time("televendas_2")
    quando nome da cidade igual("SAO JOSE DO RIO PRETO")
    frequencia de 30 dias

parametros "Irrestrito: sem regra mapeada":
    do time("televendas_2")
    frequencia de 30 dias


