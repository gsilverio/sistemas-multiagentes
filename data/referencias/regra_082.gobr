

# Regras para Rede EPI
version 1.0

time "empresa toda":
    vendedores todos

carteira "empresa toda":
    clientes carteirafixa("empresa toda")

parametros "Regra Padrao da Empresa Customizavel: semanal para clientes ativos adimplentes":
    da carteira("empresa toda")
    quando ativos para o vendedor e adimplentes
    frequencia semanal()
    preferencia nos dias uteis

parametros "Regra Padrao da Empresa Customizavel: 14 dias para clientes ativos inadimplentes":
    da carteira("empresa toda")
    quando ativos para o vendedor e inadimplentes
    frequencia de 14 dias
    preferencia nos dias uteis

parametros "Regra Padrao da Empresa Customizavel: 30 dias para clientes inativos adimplentes":
    da carteira("empresa toda")
    quando inativos para o vendedor e adimplentes
    frequencia de 30 dias
    preferencia nos dias uteis

parametros "Regra Padrao da Empresa Customizavel: nao agendar inativos inadimplentes":
    da carteira("empresa toda")
    quando inativos para o vendedor e inadimplentes
    nao agendar
    
parametros "Regra Padrao da Empresa Customizavel: 30 dias para clientes sem vendas":
    da carteira("empresa toda")
    quando sem vendas
    frequencia de 30 dias
    preferencia nos dias uteis
    
