
# Card da aplicação: https://3.basecamp.com/3199393/buckets/26567206/card_tables/cards/7693814273
version 1.0

# Definição de times
time "televendas":
    vendedores todos ativados

parametros "Diferpan: Não agendar inadimplentes":
    do time("televendas")
    quando inadimplentes
    nao agendar
    
parametros "Diferpan: Freq. de 7d para cliente que nunca tirou com o vendedor":
    do time("televendas")
    quando no ciclo de vida prospect com o vendedor
    frequencia de 7 dias
    
parametros "Diferpan: Freq. de 21d para construtora que comprou uma unica vez com o vendedor":
    do time("televendas")
    quando unica compra com o vendedor e ramo de atividade igual("37")
    frequencia de 21 dias
    
parametros "Diferpan: Freq. de 7d para cliente que comprou uma unica vez com o vendedor":
    do time("televendas")
    quando unica compra com o vendedor
    frequencia de 7 dias

parametros "Diferpan: Freq. de 7d para clientes com frequência histórica menor do que 11 dias":
    do time("televendas")
    quando frequencia historica menor que 11 dias
    frequencia de 7 dias

parametros "Diferpan: Freq. de 14d para construtora que comprou com o vendedor entre 60 dias e 89 dias":
    do time("televendas")
    quando fora da recencia de positivacao do vendedor entre 60 dias e 89 dias e ramo de atividade igual("37")
    frequencia de 14 dias

parametros "Diferpan: Freq. de 21d para construtora que comprou com o vendedor entre 11 dias e 59 dias":
    do time("televendas")
    quando fora da recencia de positivacao do vendedor entre 11 dias e 59 dias e ramo de atividade igual("37")
    frequencia de 21 dias
    
parametros "Diferpan: Freq. de 21d para clientes que comprou ultima vez com o vendedor a mais de 90 dias":
    do time("televendas")
    quando no ciclo de vida inativo com o vendedor
    frequencia de 21 dias

parametros "Diferpan: Freq. de 7d para clientes que comprou com o vendedor entre 11 dias e 89 dias":
    do time("televendas")
    quando fora da recencia de positivacao do vendedor em 90 dias
    frequencia de 7 dias

parametros "Diferpan: Freq. de 7d para demais clientes":
    do time("televendas")
    frequencia de 7 dias
    
