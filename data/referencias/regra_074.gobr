
# Regras para Bela Forma
version 1.0

time "empresa toda":
    vendedores todos

carteira "empresa toda":
    clientes carteirafixa("empresa toda")

parametros "Regra Padrao da Empresa Customizavel: 45 dias para inativos":
    da carteira("empresa toda")
    quando inativos para o vendedor
    frequencia de 45 dias
    preferencia do vendedor
    
parametros "Regra Padrao da Empresa Customizavel: 21 dias para ativos":
    da carteira("empresa toda")
    quando ativos para o vendedor
    frequencia de 21 dias
    preferencia do vendedor
    
parametros "Regra Padrao da Empresa Customizavel: 45 dias quando sem vendas":
    da carteira("empresa toda")
    quando sem vendas
    frequencia de 45 dias
    preferencia do vendedor
    
